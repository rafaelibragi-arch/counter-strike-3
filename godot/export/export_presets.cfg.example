; Example export presets — copy to export_presets.cfg in Godot editor
; or create via Project → Export.

[preset.0]
name="macOS"
platform="macOS"
runnable=true
dedicated_server=false
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path="./export/Clashpoint.app"

[preset.0.options]
application/bundle_identifier="games.clashpoint.fps"
application/name="Clashpoint"
application/short_version="0.1.0"
application/version="0.1.0"

[preset.1]
name="Web"
platform="Web"
runnable=true
dedicated_server=false
export_filter="all_resources"
export_path="./export/web/index.html"

[preset.1.options]
variant/extensions_support=false
vram_texture_compression/for_desktop=true
html/export_icon=true
html/custom_html_shell=""
progressive_web_app/enabled=false
threads/emscripten_pool_size=8
; Prefer Compatibility renderer for web (set in project or export)
