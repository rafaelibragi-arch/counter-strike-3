; Engine configuration file.
; Clashpoint movement prototype — Source/CS2-style pmove on Godot 4.

config_version=5

[application]

config/name="Clashpoint"
config/description="Clashpoint Year-1 — CS-like tactical FPS (desktop + web)"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoloads/game_state.gd"
AudioBus="*res://autoloads/audio_bus.gd"
NetSession="*res://scripts/net/net_session.gd"
Matchmaking="*res://scripts/net/matchmaking.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

