extends RefCounted
## Ported from index.html SPRAY / SPRAY_PATTERNS (yaw, pitch per shot).

static var _cache: Dictionary = {}


static func for_weapon(weapon_id: StringName) -> Array:
	if _cache.is_empty():
		_cache = _build()
	if _cache.has(weapon_id):
		return _cache[weapon_id]
	# fallbacks
	if String(weapon_id) in ["glock", "p250"]:
		return _cache.get(&"pistol", [[0.0, 0.0]])
	return [[0.0, 0.0]]


